# Database Configuration
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass

# Application Configuration
NODE_ENV=development
PYTHONPATH=/app

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Logging Configuration
LOG_LEVEL=info

# Production Database (AWS RDS) - 배포시 사용
# DATABASE_URL=postgresql://appuser:${DB_PASSWORD}@your-rds-endpoint:5432/appdb

# Development Database Password (docker-compose에서 사용)
DB_PASSWORD=apppass